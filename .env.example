# Context-path do Spring (default: /dsp-backend)
SERVER_SERVLET_CONTEXT_PATH=/dsp-backend

# Allowed CORS origins (comma-separated)
DSP_CORS_ALLOWED_ORIGINS=http://localhost,http://localhost/dsp,http://localhost:5173,http://localhost:8081

# Installation JSON file (L1/L2/L3 labels, screens, KPIs). Default: classpath:installationConfig.json
# DSP_INSTALLATION_CONFIG_FILE=file:/etc/dsp/installationConfig.json
